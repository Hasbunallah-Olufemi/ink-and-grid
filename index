<script>
(function(){
  // ---------- year + nav toggle ----------
  document.getElementById('copyrightLine').textContent = '© ' + new Date().getFullYear() + ' Hasbal Digital Creative Studio. All rights reserved.';
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');
  navToggle.addEventListener('click', () => {
    const open = navLinks.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', open);
  });
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

  // ---------- hero entrance (once) ----------
  requestAnimationFrame(() => document.getElementById('heroArt').classList.add('animate'));

  // ---------- storage helpers ----------
  async function keyExists(key, shared){
    try{
      const r = await window.storage.get(key, shared);
      return !!r;
    }catch(e){ return false; }
  }
  async function safeGet(key, shared){
    try{ return await window.storage.get(key, shared); }
    catch(e){ return null; }
  }

  // ---------- booking calendar ----------
  const SLOTS = ['9:00 AM','10:00 AM','11:00 AM','1:00 PM','2:00 PM','3:00 PM','4:00 PM'];
  const daySelector = document.getElementById('daySelector');
  const slotSelector = document.getElementById('slotSelector');
  const bookingSummary = document.getElementById('bookingSummary');
  let selectedDate = null; // {iso, label}
  let selectedSlot = null;

  function slotKeyId(t){ return t.replace(/[: ]/g,'').replace('AM','A').replace('PM','P'); }

  function buildDays(){
    const days = [];
    let d = new Date();
    while(days.length < 10){
      d.setDate(d.getDate()+1);
      const day = d.getDay();
      if(day !== 0 && day !== 6){
        days.push(new Date(d));
      }
    }
    daySelector.innerHTML = '';
    days.forEach((date, idx) => {
      const iso = date.toISOString().slice(0,10);
      const pill = document.createElement('div');
      pill.className = 'day-pill';
      pill.setAttribute('role','button');
      pill.setAttribute('tabindex','0');
      pill.innerHTML = '<span class="dow">'+date.toLocaleDateString(undefined,{weekday:'short'})+'</span><span class="dom">'+date.getDate()+'</span>';
      pill.addEventListener('click', () => selectDay(iso, date, pill));
      pill.addEventListener('keydown', e => { if(e.key==='Enter') selectDay(iso, date, pill); });
      daySelector.appendChild(pill);
      if(idx === 0) selectDay(iso, date, pill);
    });
  }

  async function selectDay(iso, dateObj, pillEl){
    document.querySelectorAll('.day-pill').forEach(p => p.classList.remove('selected'));
    pillEl.classList.add('selected');
    selectedDate = { iso, label: dateObj.toLocaleDateString(undefined,{weekday:'short', month:'short', day:'numeric'}) };
    selectedSlot = null;
    updateSummary();
    await renderSlots(iso);
  }

  async function renderSlots(iso){
    slotSelector.innerHTML = '<p style="grid-column:1/-1; font-size:0.85rem; color:var(--ink-soft);">Checking availability…</p>';
    const results = await Promise.all(SLOTS.map(async t => {
      const key = 'booking:' + iso + '_' + slotKeyId(t);
      const taken = await keyExists(key, true);
      return { t, taken };
    }));
    slotSelector.innerHTML = '';
    results.forEach(({t, taken}) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'slot-btn';
      btn.textContent = t;
      if(taken){ btn.disabled = true; }
      else{
        btn.addEventListener('click', () => {
          document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedSlot = t;
          updateSummary();
        });
      }
      slotSelector.appendChild(btn);
    });
  }

  function updateSummary(){
    if(selectedDate && selectedSlot){
      bookingSummary.textContent = selectedDate.label + ' at ' + selectedSlot;
      bookingSummary.classList.add('show');
    } else {
      bookingSummary.classList.remove('show');
    }
  }

  buildDays();

  // ---------- package pick buttons ----------
  document.querySelectorAll('.pick-package').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('bPackage').value = btn.dataset.package;
      document.getElementById('book').scrollIntoView({behavior:'smooth'});
    });
  });

  // ---------- booking form submit ----------
  const bookingForm = document.getElementById('bookingForm');
  const formMsg = document.getElementById('formMsg');
  bookingForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    formMsg.textContent = '';
    formMsg.className = 'form-msg';
    if(!selectedDate || !selectedSlot){
      formMsg.textContent = 'Pick a day and time first.';
      formMsg.className = 'form-msg error';
      return;
    }
    const submitBtn = bookingForm.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Booking…';

    const key = 'booking:' + selectedDate.iso + '_' + slotKeyId(selectedSlot);
    const alreadyTaken = await keyExists(key, true);
    if(alreadyTaken){
      formMsg.textContent = 'That slot was just taken — pick another time.';
      formMsg.className = 'form-msg error';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirm booking';
      renderSlots(selectedDate.iso);
      return;
    }

    const payload = {
      name: document.getElementById('bName').value,
      email: document.getElementById('bEmail').value,
      package: document.getElementById('bPackage').value,
      message: document.getElementById('bMessage').value,
      date: selectedDate.label,
      time: selectedSlot,
      createdAt: new Date().toISOString()
    };

    try{
      const result = await window.storage.set(key, JSON.stringify(payload), true);
      if(!result){ throw new Error('write failed'); }
      bookingForm.style.display = 'none';
      document.getElementById('confirmDetail').textContent =
        payload.package + ' — ' + payload.date + ' at ' + payload.time + '. A confirmation will be sent to ' + payload.email + '.';
      document.getElementById('confirmBox').classList.add('show');
    }catch(err){
      formMsg.textContent = "Couldn't save your booking — please try again in a moment.";
      formMsg.className = 'form-msg error';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirm booking';
    }
  });

  document.getElementById('bookAnother').addEventListener('click', () => {
    bookingForm.reset();
    bookingForm.style.display = 'block';
    document.getElementById('confirmBox').classList.remove('show');
    selectedSlot = null;
    updateSummary();
    if(selectedDate) renderSlots(selectedDate.iso);
  });

  // ---------- AI concierge ----------
  const PACKAGE_INFO = {
    'Starter Session': '$150 · one hour',
    'Project Sprint': '$1,200+ · one core deliverable',
    'Full Identity': '$3,500+ · full brand system'
  };
  document.getElementById('conciergeBtn').addEventListener('click', async () => {
    const input = document.getElementById('conciergeInput').value.trim();
    const resultBox = document.getElementById('conciergeResult');
    if(!input){
      resultBox.innerHTML = '<p class="placeholder">Add a sentence or two about the project first.</p>';
      return;
    }
    resultBox.innerHTML = '<span class="spinner"></span> <span style="font-size:0.9rem; color:var(--ink-soft);">Thinking it through…</span>';

    const prompt = 'A potential client is describing a project to a freelance graphic designer. Recommend exactly one of these three packages based on their description:\n' +
      '1. Starter Session ($150) - a one-hour consultation, best when someone needs direction or a second opinion rather than a finished deliverable.\n' +
      '2. Project Sprint ($1,200+) - one core deliverable such as a logo, landing page, or key asset, two revision rounds, two-week turnaround.\n' +
      '3. Full Identity ($3,500+) - a complete brand system: logo, color, type, guidelines, and templates, four-week turnaround.\n\n' +
      'Client description: "' + input.replace(/"/g,"'") + '"\n\n' +
      'Respond with ONLY valid JSON, no markdown fences, no extra text, in exactly this shape:\n' +
      '{"package":"Starter Session or Project Sprint or Full Identity","reason":"one short sentence","timeline":"a short estimated timeframe","nextStep":"one short encouraging sentence"}';

    try{
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 1000,
          messages: [{ role: "user", content: prompt }]
        })
      });
      const data = await response.json();
      const text = (data.content || []).map(b => b.type === 'text' ? b.text : '').join('\n');
      const clean = text.replace(/```json|```/g, '').trim();
      const parsed = JSON.parse(clean);
      const info = PACKAGE_INFO[parsed.package] || '';
      resultBox.innerHTML =
        '<p class="rec-pkg">RECOMMENDED</p>' +
        '<h4>' + parsed.package + '</h4>' +
        '<p style="color:var(--ink-soft); font-size:0.85rem;">' + info + '</p>' +
        '<p>' + parsed.reason + '</p>' +
        '<p><strong>Typical timeline:</strong> ' + parsed.timeline + '</p>' +
        '<p>' + parsed.nextStep + '</p>' +
        '<button class="btn btn-primary use-rec" style="margin-top:14px;" data-package="' + parsed.package + '">Use this package</button>';
      resultBox.querySelector('.use-rec').addEventListener('click', (e) => {
        document.getElementById('bPackage').value = e.target.dataset.package;
        document.getElementById('book').scrollIntoView({behavior:'smooth'});
      });
    }catch(err){
      resultBox.innerHTML = '<p class="placeholder">Couldn\'t reach the concierge just now. As a rule of thumb: one clear deliverable fits a Project Sprint, a full rebrand fits Full Identity, and if you just want direction, start with a Starter Session.</p>';
    }
  });

  // ---------- admin dashboard ----------
  const ADMIN_PASSCODE = 'studio2026'; // change this before sharing the file
  const adminBackdrop = document.getElementById('adminBackdrop');
  document.getElementById('adminLink').addEventListener('click', (e) => {
    e.preventDefault();
    adminBackdrop.classList.add('show');
  });
  document.getElementById('adminClose').addEventListener('click', () => adminBackdrop.classList.remove('show'));
  adminBackdrop.addEventListener('click', (e) => { if(e.target === adminBackdrop) adminBackdrop.classList.remove('show'); });

  document.getElementById('adminUnlock').addEventListener('click', () => {
    if(document.getElementById('adminPass').value === ADMIN_PASSCODE){
      document.getElementById('adminGate').style.display = 'none';
      document.getElementById('adminPanel').style.display = 'block';
      loadBookings();
    } else {
      document.getElementById('adminPass').value = '';
      document.getElementById('adminPass').placeholder = 'Wrong passcode';
    }
  });

  async function loadBookings(){
    const listEl = document.getElementById('adminList');
    listEl.innerHTML = '<p style="font-size:0.85rem; color:var(--ink-soft);">Loading…</p>';
    try{
      const res = await window.storage.list('booking:', true);
      const keys = (res && res.keys) || [];
      if(keys.length === 0){
        listEl.innerHTML = '<p style="font-size:0.85rem; color:var(--ink-soft);">No bookings yet.</p>';
        return;
      }
      const rows = await Promise.all(keys.map(k => safeGet(k, true)));
      const bookings = rows.filter(Boolean).map(r => ({ key: r.key, data: JSON.parse(r.value) }));
      bookings.sort((a,b) => (a.data.createdAt < b.data.createdAt ? 1 : -1));
      listEl.innerHTML = '';
      bookings.forEach(b => {
        const row = document.createElement('div');
        row.className = 'booking-row';
        row.innerHTML =
          '<strong>' + b.data.date + ' · ' + b.data.time + '</strong><br>' +
          b.data.name + ' — ' + b.data.email + '<br>' +
          b.data.package + (b.data.message ? ' — "' + b.data.message + '"' : '') +
          '<br><button class="btn btn-ghost del-booking" data-key="' + b.key + '">Cancel slot</button>';
        listEl.appendChild(row);
      });
      listEl.querySelectorAll('.del-booking').forEach(btn => {
        btn.addEventListener('click', async () => {
          try{
            await window.storage.delete(btn.dataset.key, true);
            loadBookings();
          }catch(e){ /* ignore */ }
        });
      });
    }catch(e){
      listEl.innerHTML = '<p style="font-size:0.85rem; color:var(--coral);">Could not load bookings.</p>';
    }
  }
  document.getElementById('adminRefresh').addEventListener('click', loadBookings);

})();
</script>
